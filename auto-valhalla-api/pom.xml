<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>auto-valhalla-api</artifactId>
  <name>auto-valhalla-api</name>

  <description>
    The @AutoValhalla annotation and AutoValhallaVerifier
  </description>

  <url>https://github.com/thunkware/auto-valhalla.git</url>
  <organization>
      <name>thunkware</name>
  </organization>

  <licenses>
      <license>
          <name>Apache 2</name>
          <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
          <distribution>manual</distribution>
          <comments>A business-friendly OSS license</comments>
      </license>
  </licenses>

  <scm>
      <connection>scm:git:git://github.com/thunkware/auto-valhalla.git</connection>
      <developerConnection>scm:git:https://github.com/thunkware/auto-valhalla.git</developerConnection>
      <url>https://github.com/thunkware/auto-valhalla</url>
      <tag>auto-valhalla-0.2.0</tag>
  </scm>

  <developers>
      <developer>
          <name>maxxedev</name>
      </developer>
  </developers>

  <properties>
    <java5.home>${env.JAVA5_HOME}</java5.home>
    <!-- Fallback release for the skip-jdk5 path (modern compiler, no JDK 5 available).
         When JAVA5_HOME is set, both AutoValhalla and AutoValhallaVerifier are compiled
         by JDK 5 javac and produce genuine class-file 49 bytecode instead. -->
    <maven.compiler.release>8</maven.compiler.release>
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- All classes are compiled by JDK 5 javac
           (see exec below); exclude them here so the modern compiler only handles
           test sources (which stay at the release=8 fallback). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <excludes>
            <exclude>**/*.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- Compile both main sources with JDK 5 javac to produce genuine class-file 49.
           JDK 5's javac -version exits non-zero, so the maven-compiler-plugin
           cannot drive it; invoke javac directly instead. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>compile-jdk5</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java5.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>1.5</argument>
                <argument>-target</argument>
                <argument>1.5</argument>
                <argument>-g</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>${project.basedir}/src/main/java/io/github/thunkware/auto/valhalla/api/AutoValhalla.java</argument>
                <argument>${project.basedir}/src/main/java/io/github/thunkware/auto/valhalla/api/AutoValhallaVerifier.java</argument>
                <argument>${project.basedir}/src/main/java/io/github/thunkware/auto/valhalla/api/ConfiguredVerifier.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <!-- Replace the pom.xml that gets installed and deployed with a
           flattened, self-contained version (parent resolved away). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>oss</flattenMode>
          <flattenedPomFilename>${project.artifactId}-${project.version}.pom</flattenedPomFilename>
          <outputDirectory>${project.build.directory}</outputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- When JAVA5_HOME is absent (local dev without the old JDK), skip the
         exec step and let the modern compiler handle AutoValhalla.java too. -->
    <profile>
      <id>skip-jdk5</id>
      <activation>
        <property>
          <name>!env.JAVA5_HOME</name>
        </property>
      </activation>
      <build>
        <plugins>
          <!-- Drop the AutoValhalla.java exclusion so the modern compiler handles it. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${maven-compiler-plugin.version}</version>
            <configuration combine.self="override" />
          </plugin>
          <!-- Disable the JDK 5 javac step. -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>compile-jdk5</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
