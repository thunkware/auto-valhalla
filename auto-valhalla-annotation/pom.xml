<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>auto-valhalla-annotation</artifactId>
  <name>auto-valhalla annotation</name>

  <description>
    The @AutoValhalla annotation
  </description>

  <properties>
    <!-- Compile with a real JDK 5 so the class file is genuine Java 5 bytecode
         (major version 49), loadable on any JVM >= 5. -->
    <java5.home>${env.JAVA5_HOME}</java5.home>
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
  </properties>

  <build>
    <plugins>
      <!-- JDK 5's javac -version exits non-zero, so the modern compiler plugin
           cannot drive it; invoke the real JDK 5 javac directly. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>compile-jdk5</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java5.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>1.5</argument>
                <argument>-target</argument>
                <argument>1.5</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>${project.basedir}/src/main/java/io/github/thunkware/auto/valhalla/AutoValhalla.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
