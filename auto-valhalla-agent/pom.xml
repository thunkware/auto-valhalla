<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla</artifactId>
    <version>0.2.1-SNAPSHOT</version>
  </parent>

  <artifactId>auto-valhalla-agent</artifactId>
  <name>auto-valhalla-agent</name>

  <url>https://github.com/thunkware/auto-valhalla.git</url>
  <organization>
      <name>thunkware</name>
  </organization>

  <licenses>
      <license>
          <name>Apache 2</name>
          <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
          <distribution>manual</distribution>
          <comments>A business-friendly OSS license</comments>
      </license>
  </licenses>

  <scm>
      <connection>scm:git:git://github.com/thunkware/auto-valhalla.git</connection>
      <developerConnection>scm:git:https://github.com/thunkware/auto-valhalla.git</developerConnection>
      <url>https://github.com/thunkware/auto-valhalla</url>
      <tag>HEAD</tag>
  </scm>

  <developers>
      <developer>
          <name>maxxedev</name>
      </developer>
  </developers>

  <properties>
    <!-- The agent's own classes are compiled without preview so the jar loads
         on a JDK 28 JVM even when preview features are off. The runtime check
         (RuntimeMXBean input arguments) then disables the agent if the JVM was
         not started with the enable-preview flag. -->
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
    <maven.compiler.source>28</maven.compiler.source>
    <maven.compiler.target>28</maven.compiler.target>
    <!-- Real JDK 5 install: the shim must be class-file version 49 so it can
         be loaded on any JVM from JDK 5 upwards. -->
    <java5.home>${env.JAVA5_HOME}</java5.home>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.thunkware</groupId>
      <artifactId>auto-valhalla-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The demo5 fixtures (genuine Java 5 bytecode) are rewritten in tests
         with the exact demo configuration, so a demo class that stops
         transforming fails the agent's unit tests. -->
    <dependency>
      <groupId>io.github.thunkware</groupId>
      <artifactId>test-lib-jdk5</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.18</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin.version}</version>
        <executions>
          <!-- Unpack the JDK 5 annotation classes into this jar so the agent is
               self-contained and can read @AutoValhalla at load time without the
               annotation artifact being on the application classpath. -->
          <execution>
            <id>embed-annotation</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>auto-valhalla-api</includeArtifactIds>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The JDK 5 shim (AutoValhallaAgent) must be class-file version 49 so
           the published agent jar is loadable on any JVM from JDK 5 upwards.
           Its source lives in src/main/java like the rest of the agent, but it
           is excluded from the JDK 28 compile so that its .class file in
           target/classes is produced only by the JDK 5 javac step below
           (guaranteed v49, no ordering race). The shim loads first and, on a
           JVM older than JDK 28, warns and returns harmlessly; on JDK 28+ it
           calls the real agent's entry point directly. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
          <debug>true</debug>
          <compilerArgs>
            <arg>-Xlint</arg>
          </compilerArgs>
          <excludes>
            <exclude>**/AutoValhallaAgent.java</exclude>
            <exclude>**/AutoValhallaAttachAgent.java</exclude>
            <exclude>**/ByteBuddyAgent.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <!-- Ensure the output directories exist; the JDK 5 compiler will not
               create them on its own. -->
          <execution>
            <id>make-output-dir</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>/bin/mkdir</executable>
              <arguments>
                <argument>-p</argument>
                <argument>${project.build.directory}/shim-classes</argument>
                <argument>${project.build.outputDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>compile-shim-jdk5</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java5.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>1.5</argument>
                <argument>-target</argument>
                <argument>1.5</argument>
                <argument>-d</argument>
                <argument>${project.build.directory}/shim-classes</argument>
                <argument>src/main/java/io/github/thunkware/auto/valhalla/AutoValhallaAgent.java</argument>
                <argument>src/main/java/io/github/thunkware/auto/valhalla/AutoValhallaAttachAgent.java</argument>
                <argument>src/main/agent5/java/io/github/thunkware/auto/valhalla/internal/bytebuddy/agent/ByteBuddyAgent.java</argument>
                <argument>src/main/agent5/java/io/github/thunkware/auto/valhalla/AutoValhallaAgent28.java</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>install-shim-class</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>/bin/cp</executable>
              <arguments>
                <argument>${project.build.directory}/shim-classes/io/github/thunkware/auto/valhalla/AutoValhallaAgent.class</argument>
                <argument>${project.build.directory}/shim-classes/io/github/thunkware/auto/valhalla/AutoValhallaAttachAgent.class</argument>
                <argument>${project.build.outputDirectory}/io/github/thunkware/auto/valhalla/</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Premain-Class>io.github.thunkware.auto.valhalla.AutoValhallaAgent</Premain-Class>
              <Agent-Class>io.github.thunkware.auto.valhalla.AutoValhallaAgent</Agent-Class>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- allow the verifier to accept the preview-version class files
               produced by the rewriter -->
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
      <!-- Spotless is enabled only in the agent module; the version and formatter
           config come from the root pom, which skips it everywhere else. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
      <!-- Replace the pom.xml that gets installed and deployed with a
           flattened, self-contained version (parent resolved away). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>oss</flattenMode>
          <flattenedPomFilename>${project.artifactId}-${project.version}.pom</flattenedPomFilename>
          <outputDirectory>${project.build.directory}</outputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- When JAVA5_HOME is absent (local dev without the old JDK), compile
         the agent with the normal compiler and skip the legacy shim steps.
         Compiling and testing still work so local IDEs and `mvn test` keep
         functioning, but packaging is refused: without the shim the jar's
         Premain/Agent entry points would be plain release-28 class files and
         silently UnsupportedClassVersionError on the JDK 5/8 JVMs the shim
         is meant to load on. -->
    <profile>
      <id>skip-jdk5</id>
      <activation>
        <property>
          <name>!env.JAVA5_HOME</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>${maven-enforcer-plugin.version}</version>
            <executions>
              <execution>
                <id>require-java5-shim</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>env.JAVA5_HOME</property>
                      <message>Cannot package the auto-valhalla agent without JAVA5_HOME.
The agent jar's entry points (AutoValhallaAgent, AutoValhallaAttachAgent,
ByteBuddyAgent) must be JDK 5 class-file version 49 so they load on the JDK
5/8 shim targets; skipping that step and packaging anyway would publish a
jar whose Premain-Class is a release-28 class file. Point JAVA5_HOME at a
real JDK 5 installation.</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${maven-compiler-plugin.version}</version>
            <configuration combine.self="override" />
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>compile-shim-jdk5</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
              <execution>
                <id>install-shim-class</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
