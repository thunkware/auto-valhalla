<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla-tests-jdk5</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>test-lib-jdk5</artifactId>
  <name>test-lib-jdk5</name>

  <description>
    A value-class candidate compiled to genuine Java 5 bytecode with a real JDK 5, proving the agent handles legacy class files.
  </description>

  <properties>
    <!-- Compile with a real JDK 5 so the class file is genuine Java 5 bytecode, loadable on any JDK 5+. -->
    <java5.home>${env.JAVA5_HOME}</java5.home>
    <!-- Neutralise the parent's JDK 28 preview settings for this module.
         (An empty maven.compiler.release would make javadoc fail with
         "release version -sourcepath not supported", so it is left unset and the
         parent's value is inherited.) -->
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.thunkware</groupId>
      <artifactId>auto-valhalla-api</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- JDK 5's javac -version exits non-zero, so the modern compiler plugin
           cannot drive it; invoke the real JDK 5 javac directly. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>compile-jdk5</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java5.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>1.5</argument>
                <argument>-target</argument>
                <argument>1.5</argument>
                <argument>-cp</argument>
                <argument>${project.basedir}/../../../auto-valhalla-api/target/auto-valhalla-api-${project.version}.jar</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>${project.basedir}/src/main/java/demo5/annotation/Point.java</argument>
                <argument>${project.basedir}/src/main/java/demo5/includes/Square.java</argument>
                <argument>${project.basedir}/src/main/java/demo5/includes/Circle.java</argument>
                <argument>${project.basedir}/src/main/java/demo5/broken/MutablePoint.java</argument>
                <argument>${project.basedir}/src/main/java/demo5/broken/SyncPoint.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- When JAVA5_HOME is absent, fall back to the modern compiler. -->
    <profile>
      <id>skip-jdk5</id>
      <activation>
        <property>
          <name>!env.JAVA5_HOME</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <configuration combine.self="override" />
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>compile-jdk5</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>true</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
