<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>auto-valhalla-demo-maven-plugin</artifactId>
  <name>auto-valhalla maven-plugin demo</name>

  <description>
    A consumer project that applies the auto-valhalla-maven-plugin: the
    @AutoValhalla classes are compiled into value-class variants under
    META-INF/versions/28 while the base classes stay ordinary identity classes,
    and the jar goal marks the packaged jar multi-release. The surefire test
    asserts the structural result and build.sh runs the packaged jar on JDK 28
    to prove the value classes are active at runtime.
  </description>

  <properties>
    <!-- The base classes stay ordinary identity classes compiled for a
         pre-Valhalla JDK (class-file 61, loadable on JDK 17+). The structural
         test inspects the produced class files by calling the JDK's own javap,
         so the tests compile at the same release as the main sources. Disable
         the preview flag inherited from the parent: disabled preview only works
         for the current release, and the base classes must target release 17. -->
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.thunkware</groupId>
      <artifactId>auto-valhalla-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- runnable directly: java -enable-preview -jar ... -->
            <manifest>
              <mainClass>demo.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.github.thunkware</groupId>
        <artifactId>auto-valhalla-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <id>transform</id>
            <goals>
              <goal>transform</goal>
            </goals>
          </execution>
          <execution>
            <id>mr-jar</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>