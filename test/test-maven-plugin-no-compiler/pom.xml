<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla-tests</artifactId>
    <version>0.2.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>test-maven-plugin-no-compiler</artifactId>
  <name>test-maven-plugin-no-compiler</name>

  <description>
    A consumer project that declares no maven-compiler-plugin at all: the
    base classes are compiled by the default lifecycle binding, steered to a
    pre-Valhalla release purely through properties. The auto-valhalla
    -maven-plugin's generate-sources goal selects the @AutoValhalla classes and
    compiles their value-class variants under META-INF/versions/28, and the
    jar goal marks the packaged jar multi-release.
  </description>

  <properties>
    <!-- the default-bound maven-compiler-plugin reads these; the base classes
         must target a pre-Valhalla release without preview -->
    <maven.compiler.release>8</maven.compiler.release>
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.thunkware</groupId>
      <artifactId>auto-valhalla-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.thunkware</groupId>
        <artifactId>auto-valhalla-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <id>transform</id>
            <goals>
              <goal>generate-sources</goal>
              <goal>compile-generated-sources</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- runnable directly: java -enable-preview -jar ... -->
            <manifest>
              <mainClass>demo.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
