<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>auto-valhalla-agent-attach</artifactId>
  <name>auto-valhalla agent attach</name>

  <description>
    Attaches the auto-valhalla agent to an already running JVM. Byte Buddy is
    shaded (relocated to io.github.thunkware.auto.valhalla.internal.bytebuddy)
    so it never leaks onto the application classpath.
  </description>

  <url>https://github.com/thunkware/auto-valhalla.git</url>
  <organization>
      <name>thunkware</name>
  </organization>

  <licenses>
      <license>
          <name>Apache 2</name>
          <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
          <distribution>manual</distribution>
          <comments>A business-friendly OSS license</comments>
      </license>
  </licenses>

  <scm>
      <connection>scm:git:git://github.com/thunkware/auto-valhalla.git</connection>
      <developerConnection>scm:git:https://github.com/thunkware/auto-valhalla.git</developerConnection>
      <url>https://github.com/thunkware/auto-valhalla</url>
      <tag>HEAD</tag>
  </scm>

  <developers>
      <developer>
          <name>maxxedev</name>
      </developer>
  </developers>

  <properties>
    <!-- The JDK 5 build of ByteBuddyAgent, whose classes the shade plugin
         relocates into the internal package. -->
    <net.bytebuddy.version>1.18.11-jdk5</net.bytebuddy.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <version>${net.bytebuddy.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.thunkware</groupId>
      <artifactId>auto-valhalla-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Shade (relocate) Byte Buddy into an internal package so it does not
           leak onto the application classpath. auto-valhalla-agent stays a
           normal dependency (its v72 classes are too new for the shade plugin
           to process, and it must not be bundled here). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>shade-bytebuddy</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <exclude>io.github.thunkware:auto-valhalla-agent</exclude>
                </excludes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>io.github.thunkware.auto.valhalla.internal.bytebuddy</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>net.bytebuddy:*</artifact>
                  <excludes>
                    <exclude>META-INF/**</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Run AFTER the shade plugin (same phase) so the flattened POM is
           derived from the dependency-reduced-pom.xml (byte-buddy removed);
           the reduced POM itself is never flattened upstream. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>oss</flattenMode>
          <flattenedPomFilename>${project.artifactId}-${project.version}.pom</flattenedPomFilename>
          <outputDirectory>${project.build.directory}</outputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>package</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
