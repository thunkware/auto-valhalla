<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.thunkware</groupId>
    <artifactId>auto-valhalla</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>auto-valhalla-agent5</artifactId>
  <name>auto-valhalla agent5 shim</name>

  <properties>
    <!-- Real JDK 5 install: the shim must be class-file version 49 so it can
         be loaded on any JVM from JDK 5 upwards. -->
    <java5.home>${env.JAVA5_HOME}</java5.home>
  </properties>

  <build>
    <finalName>auto-valhalla-agent5</finalName>
    <plugins>
      <!-- Compile the shim with a real JDK 5 compiler. The source lives under
           src/main/agent5 (outside Maven's default root), so the JDK 28 default
           compiler finds nothing to do; the resulting class is written straight
           into target/classes and packaged by the jar plugin. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <!-- Ensure the output directory exists; the JDK 5 compiler will not
               create it on its own when there is no src/main/java. -->
          <execution>
            <id>make-output-dir</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>/bin/mkdir</executable>
              <arguments>
                <argument>-p</argument>
                <argument>${project.build.outputDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>compile-shim-jdk5</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java5.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>1.5</argument>
                <argument>-target</argument>
                <argument>1.5</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>src/main/agent5/java/io/github/thunkware/auto/valhalla/AutoValhallaAgent5.java</argument>
                <argument>src/main/agent5/java/io/github/thunkware/auto/valhalla/AutoValhallaAgent.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
